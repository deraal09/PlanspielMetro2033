# Vorlage für lokale Einstellungen. Kopieren nach ".env" und anpassen.
# ".env" wird nicht eingecheckt. Keine echten Werte in diese Datei schreiben.
#
# Phase 0: Der Regelkern braucht keine Umgebungsvariablen.
# Die Platzhalter unten sind für den späteren Server gedacht und können
# sich nach der Technikentscheidung ändern.

# Port, auf dem der Spielserver lauscht
PORT=3000

# Pfad für Spielstand-Sicherung (liegt unter data/, wird nicht eingecheckt)
DATEN_PFAD=./data

# Geheimer Schlüssel für den Lehrkraft-Zugang (zufälligen langen Wert erzeugen)
LEHRKRAFT_SCHLUESSEL=
